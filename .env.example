# Copy to frontend/.env.local for local development.
# Use credentials shown by `npx supabase status`; never commit real values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
APP_ENCRYPTION_KEY_BASE64=

# With NO_LLM_MODE=true, the app uses deterministic briefing templates.
NO_LLM_MODE=true
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_JSON_MODE=false
AI_TIMEOUT_MS=12000

# Demo tuning only; any real-data privacy policy needs specialist review.
RELEASE_EPSILON_PER_COUNT=0.2
APP_DATA_MODE=synthetic